          </div>
        `;
        listEl.appendChild(el);
      });
    }

    function cancelDemoBooking(index, btn) {
      let bookings = JSON.parse(localStorage.getItem('schwanen_bookings') || '[]');
      bookings.splice(index, 1);
      localStorage.setItem('schwanen_bookings', JSON.stringify(bookings));
      btn.closest('.fixed').remove();
      // reopen
      setTimeout(viewMyBookings, 120);
    }

