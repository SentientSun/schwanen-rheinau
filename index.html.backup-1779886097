            <div>${b.checkin} → ${b.checkout}<br><span class="font-medium text-[#1f2a24]">${b.nights} Nächte • ${b.guests} Gäste</span></div>
            <div class="flex-1">${b.notes ? `<span class="text-[#c5a46e]">Hinweis:</span> ${b.notes}` : ''}</div>
          </div>
          <div class="flex gap-3 mt-4">
            <button onclick="cancelDemoBooking(${idx}, this)" class="text-xs px-4 py-1.5 rounded-full border">Anfrage stornieren (Demo)</button>
