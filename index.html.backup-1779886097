          checkout: '2026-06-19',
          guests: '4',
          total: 1870,
          nights: 7,
          name: 'Elena & Lukas Berger',
          email: 'elena.berger@me.com',
          status: 'confirmed',
          created: '2025-11-03T09:41:00.000Z',
          notes: 'Wir freuen uns sehr auf den Pool!'
        }];
