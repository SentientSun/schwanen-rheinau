  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    // Tailwind script config
    function initTailwind() {
      document.documentElement.style.setProperty('--accent', '#c5a46e');
    }

    // Language handling
    let currentLang = 'de';
    const translations = {
      de: {
        bookDirect: "Direkt buchen",
        nights: "Nächte",
        total: "Gesamt",
        savings: "Ersparnis",
      },
      en: {
        bookDirect: "Book direct",
        nights: "nights",
        total: "Total",
        savings: "You save",
      }
    };

    function switchLanguage(lang) {
      currentLang = lang;
      document.getElementById('lang-de').classList.toggle('active', lang === 'de');
      document.getElementById('lang-en').classList.toggle('active', lang === 'en');

      // Basic dynamic text updates (extendable)
      const bookBtns = document.querySelectorAll('button[onclick*="scrollToBooking"], button[onclick*="openBookingModal"]');
      bookBtns.forEach(b => {
        if (lang === 'en' && b.textContent.includes('Direkt')) b.textContent = 'Book direct & save 18%';
        if (lang === 'de' && b.textContent.includes('Book')) b.textContent = 'Jetzt direkt buchen & 18% sparen';
      });
    }

    function scrollToBooking() {
      document.getElementById('book').scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    // Price calculation
    function calculateTotal() {
      const checkin = document.getElementById('checkin').value;
      const checkout = document.getElementById('checkout').value;
      const guests = parseInt(document.getElementById('guests').value);

      if (!checkin || !checkout) return { nights: 0, total: 0, detail: '' };

      const start = new Date(checkin);
      const end = new Date(checkout);
      const nights = Math.max(1, Math.round((end - start) / (1000 * 60 * 60 * 24)));

      const baseRate = 285;
      const extraPerGuest = 20;
      const extraGuests = Math.max(0, guests - 4);
      const cleaning = 85;

      let subtotal = (baseRate + (extraPerGuest * extraGuests)) * nights;
      
      // Simple long stay discounts
      let discount = 0;
      if (nights >= 14) discount = Math.round(subtotal * 0.18);
      else if (nights >= 7) discount = Math.round(subtotal * 0.12);

      const total = subtotal + cleaning - discount;

      return {
        nights,
        total,
        detail: `${nights} Nächte • ${guests} Gäste${discount ? ' • Rabatt angewendet' : ''}`
      };
    }

    function updatePrice() {
      const result = calculateTotal();
      const totalEl = document.getElementById('total-price');
      const detailEl = document.getElementById('price-detail');
      const nightsEl = document.getElementById('total-nights');

      if (result.nights === 0) {
        totalEl.textContent = '—';
        return;
      }

      totalEl.textContent = '€' + result.total.toLocaleString('de-DE');
      detailEl.textContent = result.detail;
      nightsEl.textContent = `${result.nights} Nächte • Reinigung €85`;
    }

    // Lightbox
    const galleryImages = [
      { src: "assets/images/pool-garden.jpg", caption: "Privater Pool mit Sonnendeck und exotischem Garten — Rheinau" },
      { src: "assets/images/exterior-hero.jpg", caption: "Das historische Gebäude des ehemaligen Schwanen" },
      { src: "assets/images/pool-exterior-1.jpg", caption: "Poolbereich mit bequemen Liegen und viel Privatsphäre" },
      { src: "assets/images/living-room.jpg", caption: "Lichtdurchfluteter Wohnbereich mit Ausgang zum Garten" },
      { src: "assets/images/kitchen-hero.jpg", caption: "Professionell ausgestattete Küche mit Insel" },
      { src: "assets/images/bedroom-1.jpg", caption: "Ruhiges Schlafzimmer mit Kingsize-Bett" },
      { src: "assets/images/pool-sundeck-1.jpg", caption: "Sonnendeck und Pool — perfekt für entspannte Tage" },
      { src: "assets/images/interior-1.jpg", caption: "Stylische und hochwertige Innenarchitektur" },
      { src: "assets/images/living-1.jpg", caption: "Gemütlicher Lounge-Bereich" },
      { src: "assets/images/garden-1.jpg", caption: "Grünes Garten-Carré mit Palmen und Sonnenschein" }
    ];

    let currentLightboxIndex = 0;

    function openLightbox(index) {
      currentLightboxIndex = index;
      const lb = document.getElementById('lightbox');
      const img = document.getElementById('lightbox-image');
      const cap = document.getElementById('lightbox-caption');
      const counter = document.getElementById('lightbox-counter');

      img.src = galleryImages[index].src;
      cap.textContent = galleryImages[index].caption;
      counter.textContent = `${index + 1} / ${galleryImages.length}`;
      lb.classList.remove('hidden');
      lb.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      const lb = document.getElementById('lightbox');
      lb.classList.remove('flex');
      lb.classList.add('hidden');
      document.body.style.overflow = '';
    }

    function nextLightboxImage(e) {
      e.stopImmediatePropagation();
      currentLightboxIndex = (currentLightboxIndex + 1) % galleryImages.length;
      updateLightbox();
    }

    function prevLightboxImage(e) {
      e.stopImmediatePropagation();
      currentLightboxIndex = (currentLightboxIndex - 1 + galleryImages.length) % galleryImages.length;
      updateLightbox();
    }

    function updateLightbox() {
      const img = document.getElementById('lightbox-image');
      const cap = document.getElementById('lightbox-caption');
      const counter = document.getElementById('lightbox-counter');

      img.src = galleryImages[currentLightboxIndex].src;
      cap.textContent = galleryImages[currentLightboxIndex].caption;
      counter.textContent = `${currentLightboxIndex + 1} / ${galleryImages.length}`;
    }

    // Keyboard navigation for lightbox
    document.addEventListener('keydown', function(e) {
      const lb = document.getElementById('lightbox');
      if (lb.classList.contains('hidden')) return;

      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') {
        currentLightboxIndex = (currentLightboxIndex + 1) % galleryImages.length;
        updateLightbox();
      }
      if (e.key === 'ArrowLeft') {
        currentLightboxIndex = (currentLightboxIndex - 1 + galleryImages.length) % galleryImages.length;
        updateLightbox();
      }
    });

    // Booking modal
    let currentStep = 1;

    function openBookingModal() {
      const modal = document.getElementById('booking-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';

      // Pre-fill summary
      const res = calculateTotal();
      document.getElementById('modal-dates-summary').innerHTML = 
        `${document.getElementById('checkin').value} → ${document.getElementById('checkout').value} • ${res.nights} Nächte`;

      // Reset to step 1
      goToStep(1, true);
      updateModalSummary();
    }

    function closeBookingModal() {
      const modal = document.getElementById('booking-modal');
      modal.classList.remove('flex');
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }

    function updateModalSummary() {
      const res = calculateTotal();
      const guests = document.getElementById('guests').value;
      
      document.getElementById('m-checkin').textContent = document.getElementById('checkin').value;
      document.getElementById('m-checkout').textContent = document.getElementById('checkout').value;
      document.getElementById('m-guests').textContent = guests + ' Gäste';
      document.getElementById('m-price').textContent = '€' + res.total.toLocaleString('de-DE');
    }

    function goToStep(step, skipUpdate = false) {
      // hide all
      document.getElementById('step-1').classList.add('hidden');
      document.getElementById('step-2').classList.add('hidden');
      document.getElementById('step-3').classList.add('hidden');

      document.getElementById('step-' + step).classList.remove('hidden');
      currentStep = step;

      if (step === 1 && !skipUpdate) updateModalSummary();
    }

    function submitBookingRequest() {
      const res = calculateTotal();
      const checkin = document.getElementById('checkin').value;
      const checkout = document.getElementById('checkout').value;
      const guests = document.getElementById('guests').value;
      const first = document.getElementById('guest-first').value || 'Gast';
      const last = document.getElementById('guest-last').value || '';
      const email = document.getElementById('guest-email').value || 'gast@example.com';

      const bookingRef = 'SW-' + Date.now().toString().slice(-8);
      
      // Save to localStorage
      const booking = {
        id: bookingRef,
        checkin, checkout, guests,
        total: res.total,
        nights: res.nights,
        name: `${first} ${last}`.trim(),
        email,
        status: 'pending',
        created: new Date().toISOString(),
        notes: document.getElementById('guest-notes').value || ''
      };

      let bookings = JSON.parse(localStorage.getItem('schwanen_bookings') || '[]');
      bookings.unshift(booking);
      localStorage.setItem('schwanen_bookings', JSON.stringify(bookings));

      // Close modal
      closeBookingModal();

      // Show success
      const toast = document.getElementById('success-toast');
      document.getElementById('success-ref').innerHTML = `Buchungsnummer: <strong>${bookingRef}</strong>`;
      toast.classList.remove('hidden');
      toast.classList.add('flex');

      // Optional: show the bookings page automatically after 3s if wanted
      setTimeout(() => {
        // leave it to user
      }, 3200);
    }

    function viewMyBookings() {
