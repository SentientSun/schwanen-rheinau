    // Initialize Leaflet map
    function initMap() {
      // Rheinau coordinates (approximate center)
      const map = L.map('map', { zoomControl: false, attributionControl: false }).setView([48.650, 7.952], 13);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        className: 'grayscale-[0.85]'
      }).addTo(map);

      const marker = L.marker([48.650, 7.952]).addTo(map);
      
      marker.bindPopup(`
        <div class="text-sm">
          <strong>Schwanen Rheinau</strong><br>
          <span class="text-xs text-[#5f6b64]">Genauer Standort nach Buchungsbestätigung</span>
        </div>
      `).openPopup();

      // Disable interaction a bit for clean look but keep zoom
      map.scrollWheelZoom.disable();
      setTimeout(() => {
        map.scrollWheelZoom.enable();
      }, 2200);
    }

    // Demo: Seed one example booking if none exists
