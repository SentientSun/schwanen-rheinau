    }

    // Main initialization
    function initializeWebsite() {
      initTailwind();
      seedDemoBookingsIfNeeded();

      // Set initial price
      setTimeout(() => {
        updatePrice();
      }, 200);

      // Initialize map
      setTimeout(() => {
        initMap();
      }, 650);

      // Keyboard hint
      document.addEventListener('keydown', function(e) {
        if (e.key === '?' && document.activeElement.tagName === 'BODY') {
          e.preventDefault();
          document.getElementById('gallery').scrollIntoView({ behavior: 'smooth' });
        }
      });

      // Nice touch: clicking price area opens booking
      const priceArea = document.querySelector('#book .booking-card');
      if (priceArea) {
        priceArea.addEventListener('click', function(ev) {
          if (!ev.target.closest('input, select, button')) {
            scrollToBooking();
          }
        });
      }

      // Prefill a nice example if dates look empty
      const cin = document.getElementById('checkin');
      const cout = document.getElementById('checkout');
      if (cin && !cin.value) cin.value = '2026-08-31';
      if (cout && !cout.value) cout.value = '2026-09-05';

      // Boot language
      document.getElementById('lang-de').classList.add('active');

      // Final accessibility & polish note
      console.log('%c[Schwanen] Direct booking website initialized successfully. All images & features ready.', 'color:#5f6b64;font-size:9px');
    }

    // Boot the whole experience
    window.onload = initializeWebsite;
  </script>
